{
  "name": "@enneo/codex-mcp-server",
  "version": "0.1.0",
  "description": "MCP server for the Enneo platform — exposes profile and ticket tools using the user's Enneo API key/JWT.",
  "license": "UNLICENSED",
  "type": "module",
  "bin": {
    "enneo-codex-mcp-server": "dist/index.js"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc",
    "bundle": "npm run build && esbuild dist/index.js --bundle --platform=node --format=esm --target=node18 --outfile=bundle/index.js",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "@types/node": "^20.12.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=18"
  }
}
